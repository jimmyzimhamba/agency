# Copy this file to .env and fill in your values.
# The app runs in manual mode without GOOGLE_MAPS_API_KEY — just without discovery and map features.

# Google Maps + Places API key (required for lead discovery and map view)
# Get yours at: https://console.cloud.google.com/
# Enable: Maps JavaScript API, Places API (New)
GOOGLE_MAPS_API_KEY=

# Optional: default city for searches (can also be set in Settings UI)
DEFAULT_CITY=Harare
